{
  "name": "pestlaunch-call-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@supabase/supabase-js": "2.117.1",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "multer": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1"
  }
}
